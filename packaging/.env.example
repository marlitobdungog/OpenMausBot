# Optional: Compose uses this for the project and default data volume name.
COMPOSE_PROJECT_NAME=openmausbot
# The host-side HTTP port used by Traefik, Tailscale Serve, or another proxy.
OMB_BIND_ADDRESS=127.0.0.1
OMB_HTTP_PORT=8081
# Set this to the externally reachable URL when a proxy handles TLS.
OMB_PUBLIC_URL=https://bot.intellidentph.com
OMB_WEBHOOK_PUBLIC_URL=
# Hostname in the TLS URL above, without scheme or port.
OMB_HTTPS_HOST=bot.intellidentph.com
# Required for non-loopback binds; use the proxy source CIDRs Caddy sees.
OMB_TRUSTED_PROXY_CIDRS=
OMB_SERVER_NAME=mausbot-docker
OMB_PHONE_RELAY=
OMB_DATA_EXTERNAL=false
OMB_DATA_VOLUME=
CADDY_IMAGE=caddy:2
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=
OMB_SIGNIN_SMTP_URL=
OMB_SIGNIN_SMTP_FROM=
